# =============================================================================
# CAMILA AI BACKEND — ARCHIVO DE CONFIGURACIÓN (.env)
# Distribuidora Tridente
# =============================================================================

# Google Gemini API Key (Requerido)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Base de Datos PostgreSQL
# Nota: La base de datos es 'postgres' y el esquema de tablas es 'bdtridente'
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=bdtridente
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password_aqui

# Número Oficial de WhatsApp de Ventas Tridente (sin signo +, formato internacional)
WHATSAPP_NUMBER=56944488407

# Configuración del Servidor FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8015

# Orígenes Permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://www.distribuidoratridente.cl,https://camila.distribuidoratridente.cl,http://localhost,http://127.0.0.1

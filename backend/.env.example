# =============================================================================
# CAMILA AI BACKEND — ARCHIVO DE CONFIGURACIÓN (.env)
# Distribuidora Tridente
# =============================================================================

# Google Gemini API Key (Requerido)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Base de Datos PostgreSQL
# Nota: La base de datos es 'postgres' y el esquema de tablas es 'bdtridente'
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_SCHEMA=bdtridente
DATABASE_USER=postgres
DATABASE_PASSWORD=tu_password_aqui

# Número Oficial de WhatsApp de Ventas Tridente (sin signo +, formato internacional)
WHATSAPP_NUMBER=56944488407

# Configuración del Servidor FastAPI
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8015

# Orígenes Permitidos para CORS (separados por coma)
ALLOWED_ORIGINS=https://www.distribuidoratridente.cl,https://camila.distribuidoratridente.cl,http://localhost,http://127.0.0.1

# =============================================================================
# Configuración Servidor SMTP (Notificaciones de Cotizaciones y Leads)
# =============================================================================
SMTP_HOST=s560.v2nets.com
SMTP_PORT=465
SMTP_USERNAME=pedidos@correotridente.cl
SMTP_PASSWORD=VGv7sNGBfY8DHSV
SMTP_FROM_EMAIL=pedidos@correotridente.cl
SMTP_FROM_NAME=Distribuidora Tridente

# ID del Rol de Administradores que reciben notificaciones por correo
ADMIN_ROL_ID=29f48a5a-623c-4677-a8b8-e9c848165595

# =============================================================================
# Evolution API — WhatsApp (compartido con pedidos.distribuidoratridente.cl)
# =============================================================================
# URL base del servidor Evolution API (sin barra final)
EVOLUTION_API_URL=https://evo.distribuidoratridente.cl
# API Key global de la instancia Evolution
EVOLUTION_API_GLOBAL_KEY=tu_api_key_evolution_aqui
# Nombre de la instancia WhatsApp configurada en Evolution API
WHATSAPP_INSTANCE_NAME=tridente
